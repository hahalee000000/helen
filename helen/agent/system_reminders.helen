// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - 系统提醒中途注入机制
// ═══════════════════════════════════════════════════════════════════
//
// 对抗长对话中的指令遵循衰减（Claude Code 经验借鉴）
//
// v1.19-v1.20: 提醒间隔根据 context_usage() 动态调整
//

shared let _turn_counter = 0  // 对话轮次计数器
const REMINDER_INTERVAL = 10  // 低压默认间隔（每 10 轮）

/** 中途注入系统提醒（对抗上下文衰减）
 *  间隔根据上下文占用率动态调整：
 *  - 占用率 >= 0.7：每 3 轮提醒（高压）
 *  - 占用率 >= 0.5：每 5 轮提醒（中压）
 *  - 占用率 < 0.5：每 10 轮提醒（低压，默认） */
fn inject_system_reminders(user_input: str): str {
    _turn_counter = _turn_counter + 1

    let interval = _dynamic_interval()

    if _turn_counter % interval == 0 {
        // 内联计算占用百分比（避免再引一个 _safe_usage helper）
        let usage_pct = 0
        try { usage_pct = int(context_usage() * 100) } catch { }
        let reminder = """

<system-reminder>
这是第 """ + str(_turn_counter) + """ 轮对话（当前上下文占用 """ + str(usage_pct) + """%）。请回顾以下关键规则：
1. 不要假设环境事实（日期、目录、git 状态等），使用工具查询
2. 修改 .helen 文件后必须运行 helen check 验证
3. 不要修改 ~/helen/（Helen 语言源代码）
4. 发现 Helen 语言问题时提交 GitHub issue 到 https://github.com/hahalee000000/helen/issues
</system-reminder>

"""
        return user_input + reminder
    }

    return user_input
}

/** 根据上下文占用率动态计算提醒间隔 */
fn _dynamic_interval(): int {
    try {
        let usage = context_usage()
        if usage >= 0.7 { return 3 }    // 高压：每 3 轮
        if usage >= 0.5 { return 5 }    // 中压：每 5 轮
        return REMINDER_INTERVAL        // 低压：每 10 轮
    } catch {
        return REMINDER_INTERVAL        // API 不可用时降级
    }
}

// 注：_safe_usage() 已内联到 inject_system_reminders()，避免与
// context_manager._safe_context_usage() 重复。

/** 获取当前对话轮次 */
fn get_turn_counter(): int {
    return _turn_counter
}

/** 重置对话轮次计数器（/clear 时调用） */
fn reset_turn_counter() {
    _turn_counter = 0
}
