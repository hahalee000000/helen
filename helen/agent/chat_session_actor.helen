// chat_session_actor.helen - 长驻聊天 Actor（唯一编排器）
//
// v1.0 架构简化：合并所有 specialist agents 的工具函数到 ChatSessionActor。
// LLM 直接使用所有工具，按需 load_skill 获取领域知识。
// 通过 Channel mailbox 与 Python 端通信。
// 斜杠命令在 actor 上下文中执行，可直接访问工作记忆。
//
// 架构目标：
// 1. 消除 resume_session 瓶颈 - actor 长驻，上下文在 store 中自然累积
// 2. 流式 chunk 保持 FFI 路径（不走 channel）- 低延迟
// 3. Channel 仅用于控制消息（user_input / response_complete / exit）
// 4. 斜杠命令在 actor 内执行，可访问 actor 的工作记忆和上下文统计
// 5. 无 specialist agents - LLM 直接调用所有工具（减少 LLM 调用次数）
//
// 启动时显式 resume 传入的 session_id，继承历史上下文。
// 后续对话在同一个 session 中累积，无需再次 resume。

import "task_manager.helen"
import "commands.helen"
import "context_manager.helen"
import "memory_utils.helen"
import "output.helen"
import "context.helen"
import "utils.helen"
import "contracts/contracts.helen"
import "session_stats.helen"

/** ChatSessionActor - 长驻聊天 actor（唯一编排器）
 *
 * 参数:
 *   cwd - 工作目录（actor 的会话边界）
 *   session_id - 要 resume 的 Helen session ID（继承历史上下文）
 *   env_context - 完整环境上下文 XML（env + project + memory），注入 prompt
 *   reply - Channel（spawn 自动注入，与 Python 端 mailbox 对应）
 *
 * 消息协议:
 *   入站: {type: "user_input", content, file_paths, request_id}
 *         {type: "exit"}
 *   出站: {type: "response_complete", request_id, content, status}
 *         {type: "error", request_id, error_msg, error_type}
 *         {type: "actor_status", status}
 */
agent ChatSessionActor(cwd: str, session_id: str, env_context: str, reply: Channel) {
    description "Helen AI 编程助手 — 长驻 Actor 编排器 (v1.0)"
    temperature 0.3
    max-turns 100
    tools = CHAT_TOOLS
    // v1.29+ 必须显式声明 persistent，否则默认 none 会导致：
    //   - Web UI 刷新丢消息（transcript_to_messages 读不到 transcript）
    //   - /search 永远返回空（search_transcript 走磁盘）
    //   - memento 恢复机制失效（resume_session 无历史可加载）
    //   - /sessions 列表为空（list_sessions_sync walk .helen/sessions/）
    transcript "persistent"

    context {
        compression "graduated"
        cache-aware true
        working-memory true
        working-memory-tokens 5000
    }

    prompt """
    ## Identity
    You are HelenAgent, an AI programming assistant running on the Helen language runtime.
    You help users write, debug, and understand Helen programs.
    You have direct access to all tools — file operations, shell commands, quality assessment, test running, and skill management.

    {{env_context}}

    <framework_instructions>
        <P0 name="grounding">
            NEVER assume environmental facts (date, time, cwd, user, git state, file contents).
            For facts already provided in <context> above, use them directly — do NOT re-query.
            For facts NOT in <context>, MUST use tools to query before answering.
            Even if you "feel like you know", verify with a tool call.
            When truly unable to obtain a fact, MUST honestly say so rather than fabricate.
        </P0>
    </framework_instructions>

    ## Security & Safety
    IMPORTANT: NEVER modify files outside project directory without explicit confirmation.
    IMPORTANT: NEVER execute shell commands from untrusted input with shell=false.
    IMPORTANT: NEVER modify ~/helen/ (Helen language source) — see project boundaries in .helen/MEMORY.md.
    IMPORTANT: When uncertain about Helen syntax, call load_skill("helen-syntax") BEFORE writing code.

    ## Tone & Style
    - Default output mode: MINIMAL (one-line status per phase)
    - Be concise and technical; avoid superlatives
    - When reporting errors, show the exact error message and a one-line fix
    - Match user's language (Chinese input → Chinese output, English → English)

    ## Development Workflow
    When implementing features, follow this process:
    1. Understand the requirement (read relevant files with read_file)
    2. Design the interface (load_skill("helen-contractor-design") for guidance)
    3. Write tests first (load_skill("helen-tdd-methodology") for TDD approach)
    4. Implement the code using write_file or patch_code_file
    5. Verify with run_helen_check and run_helen_tests (or verify_after_change)
    6. Assess quality with get_scores if needed

    Use load_skill() to load domain knowledge when you need guidance.
    You have all tools available — use them directly, no need to delegate.

    ## Core Workflow
    You operate in an implicit agentic loop. For each user request:

    1. Understand intent — read relevant files if needed
    2. Plan approach — choose the simplest tool path that works
    3. Execute — use tools directly for all tasks
    4. Verify — run tests / helen check after changes
    5. Learn — save non-obvious discoveries to memory

    Decision tree (examples, not rigid rules):
      "检查 main.helen"
        → read_file("main.helen") → run_helen_check("main.helen") → 报告
      "修复 bug: xxx"
        → read_file(相关文件) → write_file/patch_file → shell_exec("helen test") → 报告
      "设计一个 auth 接口"
        → load_skill("helen-contractor-design") → read_file → write_file → 报告
      "给 auth 模块写完整测试"
        → load_skill("helen-test-patterns") → read_file → write_file(test) → run_helen_tests → 报告
      "用 TDD 实现这个功能"
        → load_skill("helen-tdd-methodology") → write_file(test) → run_single_test(确认失败) → write_file(实现) → verify_after_change → 报告
      "实现一个完整的 HTTP 服务器"
        → create_project_structure → 设计 → 测试 → 实现 → 验证（使用所有工具）
      "解释这段代码"
        → read_file → 直接回答（不用工具）
      "评估代码质量"
        → get_scores(path) → 报告

    ## Tool Usage Policy
    Priority order:
    1. read_file (not shell_exec(cat)) — for file reading
    2. **save_code_file / patch_code_file** — for code changes on .helen files (auto-runs helen check)
    3. write_file / patch_file — for non-code files
    4. shell_exec — for running commands
    5. load_skill("helen-syntax") / load_skill("helen-stdlib") — before writing unfamiliar code
    6. run_helen_check(path) — for manual syntax check
    7. verify_after_change / run_single_test — for TDD workflow
    8. get_scores / get_metrics — for quality assessment
    9. **pre_exit_check** — call before session ends

    PostToolUse hooks:
    - save_code_file/patch_code_file automatically run `helen check` on .helen files.
    - pre_exit_check reminds you to save important learnings via update_memory.

    NEVER use:
    - shell_exec("rm -rf /") or similar destructive commands
    - eval / exec (code injection risk)

    ## Automatic Memory Management
    IMPORTANT: Proactively save non-obvious discoveries to memory using update_memory().
    Trigger conditions: error fixes, Helen language quirks, new workflows, user preferences, project conventions.

    Memory categories: "helen_syntax", "error_patterns", "workflows", "project_conventions", "user_preferences"

    ## Memory Size Management
    - .helen/MEMORY.md: ≤ 5KB
    - .helen/USER.md: ≤ 2KB
    When over limit: archive to .helen/archive/YYYY-MM.md

    ## Reminders
    IMPORTANT: Use tools directly for all tasks — you have all the capabilities.
    IMPORTANT: Load skills before writing Helen code you're unsure about.
    IMPORTANT: Never modify ~/helen/ — it's the language runtime.
    IMPORTANT: Submit Helen issues to https://github.com/hahalee000000/helen/issues.
    """

    functions {
        // ── 基础设施 ──

        fn _init_actor_output() {
            try {
                init_output()
                set_output_level(OUTPUT_MINIMAL)
            } catch {}
        }

        fn _emit_actor_stream_event(event_type: str, data: str) {
            try {
                ensure_python_path()
                import "ui.stream_emitter" as ActorStreamEmitter
                ActorStreamEmitter.emit_stream_event(event_type, data)
            } catch {}
        }

        fn _actor_emit_statusline() {
            try {
                import "ui.status_emitter" as _StatusMod
                let stats = context_stats()
                let ratio = stats["usage_ratio"]
                _StatusMod.emit_status(ratio, "qwen3.7-max")
            } catch {}
        }

        fn _build_actor_media_parts(file_paths: list): list {
            let media_parts = []
            if file_paths == null || len(file_paths) == 0 {
                return media_parts
            }
            for path in file_paths {
                try {
                    let media_obj = media(path)
                    media_parts = media_parts + [media_obj]
                } catch RuntimeError err {
                    _emit_actor_stream_event("error", "无法加载文件: " + path + " (" + err.message + ")")
                } catch {
                    _emit_actor_stream_event("error", "无法加载文件: " + path)
                }
            }
            return media_parts
        }

        // ── 流式回调 ──

        fn _actor_chunks_cb(text) {
            try {
                import "ui.stream_emitter" as _CancelCheck
                if _CancelCheck.is_cancel_requested() {
                    cancel_all_llm_calls()
                    _CancelCheck.clear_cancel()
                    return
                }
            } catch {}
            _emit_actor_stream_event("llm_chunk", text)
        }

        fn _actor_complete_cb() {
            _emit_actor_stream_event("llm_complete", "")
            _actor_emit_statusline()
        }

        fn _actor_tool_end_cb(tool_name, tool_result) {
            _actor_emit_statusline()
            try {
                import "ui.hint_queue" as _HintQueueMod
                let q = _HintQueueMod.get_hint_queue()
                let sid = get_session_id()
                if sid == "" { return null }
                let hints = q.pop_all_hints(sid)
                if len(hints) == 0 { return null }
                let parts = []
                for h in hints {
                    parts = parts + ["[用户追加提示] " + h.text]
                }
                let merged = join(parts, "\n\n")
                _emit_actor_stream_event("hint_injected", merged)
                return merged
            } catch {
                return null
            }
        }

        // ── 斜杠命令处理（在 actor 上下文中执行，可访问工作记忆）──

        fn _handle_actor_command(msg: map, reply: Channel): bool {
            let user_content = msg["content"]
            let request_id = msg["request_id"]

            let cmd = parse_command(user_content)
            if !cmd["is_command"] {
                return false
            }

            // /quit /exit：Web UI 由前端处理关闭，actor 只返回提示
            if cmd["command"] == "quit" || cmd["command"] == "exit" {
                reply.send({
                    "type": "response_complete",
                    "request_id": request_id,
                    "content": "请关闭浏览器标签页退出",
                    "status": "success"
                })
                return true
            }

            // 执行命令（在 actor 上下文中，可访问 actor 的 working_memory）
            // 防御：命令执行可能抛出异常（如 working_memory_get 返回超大 map）
            let cmd_response = ""
            try {
                cmd_response = execute_command(cmd)
            } catch RuntimeError err {
                cmd_response = "❌ 命令执行失败: " + err.message
            } catch {
                cmd_response = "❌ 命令执行失败（未知错误）"
            }

            // /clear：嵌入标记，Python 端据此清空 DB 消息
            if cmd["command"] == "clear" {
                cmd_response = cmd_response + "\n__HELEN_CLEAR_OK__"
            }

            // /clear-session：嵌入标记 + actor 退出，等 Python 重启
            if cmd["command"] == "clear-session" {
                cmd_response = cmd_response + "\n__HELEN_RESTART_ACTOR__"
            }

            // 命令可能改变上下文，刷新 statusline
            try { _actor_emit_statusline() } catch {}

            // 发送响应（防御：channel 可能已关闭）
            try {
                reply.send({
                    "type": "response_complete",
                    "request_id": request_id,
                    "content": cmd_response,
                    "status": "success"
                })
            } catch RuntimeError err {
                debug("_handle_actor_command: reply.send failed: " + err.message)
            } catch {}

            // /clear-session 后 actor 退出
            if cmd["command"] == "clear-session" {
                try { reply.send({"type": "actor_status", "status": "exited"}) } catch {}
                try { reply.close() } catch {}
            }

            return true
        }

        // ── 用户输入处理 ──

        fn _handle_actor_user_input(msg: map, reply: Channel, request_count: int): int {
            let user_content = msg["content"]
            let file_paths = msg["file_paths"]
            let request_id = msg["request_id"]

            let new_count = request_count + 1
            debug("ChatSessionActor: handling request " + request_id + " (#" + str(new_count) + ")")

            // 统计轮次
            try { SessionStats.increment_turns() } catch {}

            _emit_actor_stream_event("processing_start", user_content)

            let media_parts = _build_actor_media_parts(file_paths)

            // ── 周期性上下文压缩（防止长对话溢出）──
            // 每轮 LLM 调用前检查，占用率 > 70% 时自动压缩
            try {
                let usage = context_usage()
                if usage > 0.7 {
                    debug("ChatSessionActor: context usage " + str(int(usage * 100)) + "% > 70%, auto-compressing...")
                    let result = compress_context("auto")
                    debug("ChatSessionActor: auto-compressed: " + json_stringify(result))
                }
            } catch RuntimeError err {
                debug("ChatSessionActor: pre-LLM compression failed: " + err.message)
            } catch {
                debug("ChatSessionActor: pre-LLM compression failed (unknown)")
            }

            let full_response = ""
            try {
                if len(media_parts) > 0 {
                    full_response = llm act user_content media(media_parts)
                        on_chunk _actor_chunks_cb
                        on_complete _actor_complete_cb
                        on_tool_end _actor_tool_end_cb
                } else {
                    full_response = llm act user_content
                        on_chunk _actor_chunks_cb
                        on_complete _actor_complete_cb
                        on_tool_end _actor_tool_end_cb
                }
            } catch RuntimeError err {
                debug("ChatSessionActor: LLM error: " + err.message)
                _emit_actor_stream_event("error", "LLM 错误: " + err.message)
                reply.send({
                    "type": "error",
                    "request_id": request_id,
                    "error_msg": err.message,
                    "error_type": "runtime_error"
                })
                _emit_actor_stream_event("processing_complete", "")
                return new_count
            } catch {
                debug("ChatSessionActor: LLM error (unknown)")
                _emit_actor_stream_event("error", "LLM 错误: 未知错误")
                reply.send({
                    "type": "error",
                    "request_id": request_id,
                    "error_msg": "Unknown LLM error",
                    "error_type": "unknown"
                })
                _emit_actor_stream_event("processing_complete", "")
                return new_count
            }

            reply.send({
                "type": "response_complete",
                "request_id": request_id,
                "content": full_response,
                "status": "success"
            })

            _emit_actor_stream_event("processing_complete", "")
            return new_count
        }

        // ── 质量检查与测试工具（从 specialist agents 合并）──

        fn verify_after_change(file_path: str, test_file: str): map {
            if validate_path(file_path) == "" || validate_path(test_file) == "" {
                return {
                    "check_valid": false, "check_output": "Error: invalid path characters",
                    "test_passed": false, "test_output": "Error: invalid path characters"
                }
            }
            let check = shell_exec("helen check " + file_path)
            let test = shell_exec("helen test " + test_file, timeout=120)
            return {
                "check_valid": contains(check, "OK"),
                "check_output": check,
                "test_passed": contains(test, "ALL TESTS PASSED"),
                "test_output": test
            }
        }

        fn run_single_test(test_file: str, test_name: str): map {
            if validate_path(test_file) == "" || validate_path(test_name) == "" {
                return {"output": "Error: invalid path characters", "passed": false}
            }
            let cmd = "helen test " + test_file + " --filter " + test_name
            let result = shell_exec(cmd, timeout=30)
            return {"output": result, "passed": contains(result, "PASSED")}
        }

        fn get_scores(path: str): map {
            if validate_path(path) == "" {
                return {
                    "scores": {"overall": 0}, "syntax_error": true,
                    "syntax_output": "Error: invalid path characters"
                }
            }
            let check_result = shell_exec("helen check " + path)
            if !contains(check_result, "OK") {
                return {
                    "scores": {"overall": 0}, "syntax_error": true,
                    "syntax_output": check_result
                }
            }
            let content = read_file(path)
            let scores = quality_score(content, path)
            let security = check_security(content)
            return {"scores": scores, "security": security}
        }

        fn get_metrics(path: str): map {
            let content = read_file(path)
            return analyze_code(content, path)
        }

        fn run_helen_check(file_path: str): map {
            if validate_path(file_path) == "" {
                return {"output": "Error: invalid path", "valid": false}
            }
            let cmd = "helen check " + file_path
            let result = shell_exec(cmd)
            return {"output": result, "valid": contains(result, "OK")}
        }

        fn run_helen_tests(test_path: str): map {
            if validate_path(test_path) == "" {
                return {"output": "Error: invalid path", "success": false}
            }
            let cmd = "helen test " + test_path
            let result = shell_exec(cmd, timeout=120)
            return {"output": result, "success": contains(result, "ALL TESTS PASSED")}
        }

        fn create_project_structure(project_dir: str, project_name: str): map {
            let task_id = generate_task_id("", project_name)
            let task_dir = create_task_directory(project_dir, task_id)
            let paths = get_task_paths(task_dir)
            return {"task_id": task_id, "task_dir": task_dir, "paths": paths}
        }

        // ── Hooks ──

        fn save_code_file(path: str, content: str): map {
            try {
                write_file(path, content)
            } catch RuntimeError err {
                return {"status": "error", "message": "写入失败: " + err.message}
            }
            if endswith(path, ".helen") {
                if validate_path(path) == "" {
                    return {"status": "written", "check_passed": false, "check_output": "Error: invalid path"}
                }
                let check_result = shell_exec("helen check " + path)
                let valid = contains(check_result, "OK")
                if !valid {
                    warning("⚠️ helen check 失败: " + path)
                    return {"status": "written", "check_passed": false, "check_output": check_result}
                }
                return {"status": "written", "check_passed": true, "check_output": check_result}
            }
            return {"status": "written"}
        }

        fn patch_code_file(path: str, old_code: str, new_code: str): map {
            let patch_result = ""
            try {
                patch_result = patch_file(path, old_code, new_code)
            } catch RuntimeError err {
                return {"status": "error", "message": "Patch 失败: " + err.message}
            }
            if endswith(path, ".helen") {
                if validate_path(path) == "" {
                    return {"status": "patched", "check_passed": false, "check_output": "Error: invalid path"}
                }
                let check_result = shell_exec("helen check " + path)
                let valid = contains(check_result, "OK")
                if !valid {
                    warning("⚠️ helen check 失败: " + path)
                    return {"status": "patched", "check_passed": false, "check_output": check_result}
                }
                return {"status": "patched", "check_passed": true, "check_output": check_result}
            }
            return {"status": "patched"}
        }

        fn pre_exit_check(): map {
            let warnings = []
            let stats = {"message_count": 0, "skill_eval_status": "idle"}

            let memory_status = {"memory_md_ok": true, "user_md_ok": true}
            try {
                let mem_size = len(read_file(".helen/MEMORY.md"))
                if mem_size > 5120 {
                    warnings = warnings + [".helen/MEMORY.md 超过 5KB，请整理并归档到 .helen/archive/"]
                    memory_status["memory_md_ok"] = false
                }
            } catch {}
            try {
                let user_size = len(read_file(".helen/USER.md"))
                if user_size > 2048 {
                    warnings = warnings + [".helen/USER.md 超过 2KB，请精简用户偏好"]
                    memory_status["user_md_ok"] = false
                }
            } catch {}

            return {
                "warnings": warnings, "session_stats": stats, "memory_status": memory_status,
                "reminder": "如本次会话有重要学习，请调用 update_memory 保存"
            }
        }

        // ── 技能管理工具（从 SkillEvaluator 合并）──

        fn list_existing_skills(): list {
            if !path_exists("./.helen/skills") {
                return []
            }
            let result = shell_exec("find ./.helen/skills -name 'SKILL.md' 2>/dev/null | head -50")
            if result == "" {
                return []
            }
            let lines = split(strip(result), "\n")
            let filtered = []
            for line in lines {
                if strip(line) != "" {
                    filtered = filtered + [strip(line)]
                }
            }
            return filtered
        }

        fn read_skill_content(skill_name: str): str {
            let result = load_skill(skill_name)
            let parsed = json_parse(result)
            if parsed["content"] != null {
                return parsed["content"]
            }
            return ""
        }

        fn save_new_skill(name: str, category: str, tags: str, content: str): map {
            if validate_path(name) == "" || validate_path(category) == "" {
                return {"status": "error", "path": ""}
            }
            let dir = "./.helen/skills/" + category + "/" + name
            mkdir_p(dir)
            let frontmatter = "---\nname: " + name + "\n"
                + "description: \"" + substring(content, 0, 80) + "\"\n"
                + "tags: " + tags + "\n"
                + "version: 1.0.0\n---\n\n"
            write_file(dir + "/SKILL.md", frontmatter + content)
            refresh_skill_index()
            return {"status": "saved", "path": dir}
        }

        fn update_existing_skill(skill_path: str, addition: str): map {
            if validate_path(skill_path) == "" {
                return {"status": "error", "path": ""}
            }
            if !startswith(skill_path, ".helen/skills/") && !startswith(skill_path, "./.helen/skills/") {
                return {"status": "error", "path": "",
                        "reason": "只允许更新 .helen/skills/ 下的技能"}
            }
            let content = read_file(skill_path)
            write_file(skill_path, content + "\n\n" + addition + "\n")
            return {"status": "updated", "path": skill_path}
        }

        fn refresh_skill_index(): str {
            if !path_exists("./.helen/skills") {
                return ""
            }
            let result = shell_exec(
                "find ./.helen/skills -name 'SKILL.md' -exec sh -c '"
                + "for f do "
                + "  echo \"---\"; "
                + "  echo \"file: $f\"; "
                + "  head -6 \"$f\"; "
                + "  echo; "
                + "done' _ {} + 2>/dev/null"
            )

            let temp_path = "./.helen/skills/SKILL_INDEX.md.tmp"
            let final_path = "./.helen/skills/SKILL_INDEX.md"
            try {
                write_file(temp_path, result)
                shell_exec("mv " + temp_path + " " + final_path)
            } catch {
                try {
                    write_file(final_path, result)
                } catch {
                    // 写入失败时静默忽略
                }
            }
            return result
        }
    }

    main {
        // ── 恢复会话历史 ──
        if session_id != "" {
            try {
                resume_session(session_id)
                debug("ChatSessionActor: resumed session " + session_id)

                // ── 上下文压缩（防止历史 boilerplate 导致溢出）──
                // resume 后会加载所有历史消息，包括重复的 prompt boilerplate
                // 如果占用率 > 60%，强制压缩（summarize 策略，LLM 生成语义摘要）
                try {
                    let usage = context_usage()
                    if usage > 0.6 {
                        debug("ChatSessionActor: context usage " + str(int(usage * 100)) + "% > 60%, compressing...")
                        let result = compress_context("summarize")
                        debug("ChatSessionActor: compressed context: " + json_stringify(result))
                    }
                } catch RuntimeError err {
                    debug("ChatSessionActor: compression check failed: " + err.message)
                } catch {
                    debug("ChatSessionActor: compression check failed (unknown)")
                }
            } catch RuntimeError err {
                debug("ChatSessionActor: resume failed: " + err.message)
            } catch {
                debug("ChatSessionActor: resume failed (unknown error)")
            }
        } else {
            debug("ChatSessionActor: starting with fresh session")
        }

        // ── 初始化 ──
        _init_actor_output()
        try { ContextManager.init() } catch {}
        try { SessionStats.init() } catch {}

        // ── 保存主、子 session id 到 memento（供下次启动恢复）──
        // 主 session_id 是参数 session_id；子 session_id 是 Actor 自己的 get_session_id()
        // memento 文件：<cwd>/.helen/current_session_id，JSON: {"main":"...", "child":"..."}
        try {
            let my_sid = get_session_id()
            let memento_content = json_stringify({"main": session_id, "child": my_sid})
            let memento_path = cwd + "/.helen/current_session_id"
            write_file(memento_path, memento_content)
            debug("ChatSessionActor: saved memento main=" + session_id + " child=" + my_sid)
        } catch RuntimeError err {
            debug("ChatSessionActor: memento save failed: " + err.message)
        } catch {
            debug("ChatSessionActor: memento save failed (unknown)")
        }

        debug("ChatSessionActor: initialization complete for cwd=" + cwd)

        // 请求计数器
        let request_count = 0

        // ── 主循环 ──
        while true {
            let request_msg = reply.receive()

            if request_msg == null {
                debug("ChatSessionActor: channel closed, exiting")
                break
            }

            // 整个消息处理包在外层 try-catch，防止任何未捕获异常杀死 actor
            try {
                let msg_type = ""
                try {
                    msg_type = request_msg["type"]
                } catch {
                    debug("ChatSessionActor: invalid message (no type field)")
                    continue
                }

                if msg_type == "exit" {
                    debug("ChatSessionActor: received exit signal")
                    try { reply.send({"type": "actor_status", "status": "exited"}) } catch {}
                    try { reply.close() } catch {}
                    break
                }

                if msg_type == "user_input" {
                    // 斜杠命令拦截（在 actor 上下文中执行）
                    let is_command = false
                    try {
                        is_command = _handle_actor_command(request_msg, reply)
                    } catch RuntimeError err {
                        debug("ChatSessionActor: command error: " + err.message)
                    } catch {}

                    if !is_command {
                        request_count = _handle_actor_user_input(request_msg, reply, request_count)
                    } else {
                        request_count = request_count + 1
                        // /clear-session 后 actor 的 reply 已 close
                        if reply.is_closed() {
                            break
                        }
                    }
                }
            } catch RuntimeError err {
                debug("ChatSessionActor: uncaught error in main loop: " + err.message)
                // 尝试通知 Python 端
                try {
                    let req_id = ""
                    try { req_id = request_msg["request_id"] } catch {}
                    if req_id != "" {
                        reply.send({
                            "type": "error",
                            "request_id": req_id,
                            "error_msg": "Actor 内部错误: " + err.message,
                            "error_type": "internal_error"
                        })
                    }
                } catch {}
            } catch {
                debug("ChatSessionActor: uncaught unknown error in main loop")
            }
        }

        debug("ChatSessionActor: exited main loop, total requests: " + str(request_count))
    }
}
