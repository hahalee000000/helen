// chat_actor.helen — Web UI 的 Helen 侧接口（Actor 模式）
//
// v1.0 架构简化：移除非 actor 路径，只保留 actor 生命周期管理。
// 所有对话和斜杠命令都通过 ChatSessionActor 处理。
//
// v1.46.15: 添加 ChatSessionActor 自动重启机制和健康检查

import std.core.*
import std.data.*
import std.debug.*
import std.system.*
import std.path.*
import std.time.*
import std.transcript.*
import "chat_session_actor.helen"
import "output.helen"
import "utils.helen"
import "context.helen"
import "context_manager.helen"
import "memory_utils.helen"

// ── Actor 生命周期 ──

shared let _chat_actor_mailbox = null
shared let _chat_actor_session_id = ""
shared let _chat_actor_req_counter = 0
shared let _chat_actor_last_heartbeat = 0.0  // v1.46.15: 心跳时间戳
shared let _chat_actor_restart_count = 0      // v1.46.15: 重启次数

/** 启动长驻 ChatSessionActor（如果尚未启动）
 *  计算完整环境上下文（env + project + memory）传给 actor。
 *  返回 mailbox（Channel），Python 端通过 mailbox.send/receive 通信。 */
fn spawn_chat_actor(): map {
    if _chat_actor_mailbox != null {
        return {
            "status": "already_running",
            "session_id": _chat_actor_session_id
        }
    }

    // 获取当前 session_id
    let sid = get_session_id()

    // 计算完整环境上下文（env + project + memory）
    // 在 spawn 前计算，因为 spawn 后 actor 在独立线程，无法访问主线程的 shared let
    let full_env_context = ""
    try {
        // 初始化输出和上下文管理器（主线程侧）
        init_output()
        set_output_level(OUTPUT_MINIMAL)
        try { ContextManager.init() } catch {}

        // 环境事实
        let all_facts = collect_all_facts()
        let env_ctx = build_full_context_xml(all_facts)

        // 项目事实
        let proj_facts = collect_project_facts()
        let proj_ctx = build_project_context_xml(proj_facts)

        // 记忆上下文
        let memory_ctx = build_memory_context()

        // 组合
        full_env_context = env_ctx
        if proj_ctx != "" {
            full_env_context = full_env_context + "\n" + proj_ctx
        }
        if memory_ctx != "" {
            full_env_context = full_env_context + "\n" + memory_ctx
        }

        // 注入用户首选语言（来自前端 UI 设置）
        // 这比 OS locale 更准确地反映用户的实际语言偏好
        let user_lang = env_get("HELEN_WEBUI_LANG", "")
        if user_lang == "" {
            user_lang = "en"
        }
        full_env_context = full_env_context + "\n<preferred_language>" + user_lang + "</preferred_language>"
    } catch RuntimeError err {
        debug("spawn_chat_actor: env context build failed: " + err.message)
    } catch {
        debug("spawn_chat_actor: env context build failed (unknown)")
    }

    // spawn ChatSessionActor（传入完整环境上下文）
    // v1.0 session 恢复：读取 memento 中的子 session_id，用 spawn resume() 复用历史子 session
    // v1.46.12: PID 验证——只信任当前进程写入的 memento，防止多实例竞争导致
    // 错误 resume 到其他进程的 session。旧 memento（无 pid 字段）仍然接受（向后兼容）。
    let child_sid = ""
    try {
        let memento_path = get_cwd() + "/.helen/current_session_id"
        if path_exists(memento_path) {
            let content = read_file(memento_path)
            let data = json_parse(content)
            // PID 验证：检查 memento 是否由当前进程写入
            let memento_pid = 0
            try {
                memento_pid = data["pid"]
            } catch {
                // 旧 memento 无 pid 字段——接受（向后兼容）
                memento_pid = pid()
            }
            if memento_pid == pid() {
                child_sid = data["child"]
            } else {
                debug("spawn_chat_actor: memento PID mismatch (memento=" + str(memento_pid) + " own=" + str(pid()) + ") — starting fresh session")
            }
        }
    } catch {
        debug("spawn_chat_actor: memento 读取失败（首次运行或格式错误）")
    }

    let mailbox = null
    try {
        if child_sid != "" {
            mailbox = spawn ChatSessionActor(get_cwd(), sid, full_env_context) resume(child_sid)
            debug("spawned ChatSessionActor with session_id=" + sid + " resume(child=" + child_sid + ")")
        } else {
            mailbox = spawn ChatSessionActor(get_cwd(), sid, full_env_context)
            debug("spawned ChatSessionActor with session_id=" + sid + " (fresh child session)")
        }
    } catch RuntimeError err {
        return {
            "status": "error",
            "error": "spawn failed: " + err.message
        }
    } catch {
        return {
            "status": "error",
            "error": "spawn failed"
        }
    }

    _chat_actor_mailbox = mailbox
    _chat_actor_session_id = sid
    _chat_actor_last_heartbeat = time()  // v1.46.15: 记录启动时间

    return {
        "status": "started",
        "session_id": _chat_actor_session_id
    }
}

/** v1.46.15: 检查 ChatSessionActor 是否存活
 *  通过尝试发送心跳消息并检测 mailbox 状态来判断。
 *  返回: true 如果 actor 存活，false 如果已退出 */
fn _is_chat_actor_alive(): bool {
    if _chat_actor_mailbox == null {
        return false
    }

    // 尝试发送心跳消息
    try {
        _chat_actor_mailbox.send({"type": "heartbeat"})
        // 如果能发送，认为 actor 还活着
        // 实际的心跳响应由 actor 的主循环处理
        return true
    } catch RuntimeError err {
        debug("ChatSessionActor health check failed: " + err.message)
        return false
    } catch {
        debug("ChatSessionActor health check failed (unknown error)")
        return false
    }
}

/** v1.46.15: 确保 ChatSessionActor 存活，如果退出则自动重启
 *  返回: true 如果 actor 存活或成功重启，false 如果失败 */
fn _ensure_chat_actor_alive(): bool {
    if _is_chat_actor_alive() {
        return true
    }

    // Actor 已退出，记录日志
    _chat_actor_restart_count = _chat_actor_restart_count + 1
    debug("ChatSessionActor exited unexpectedly (restart_count=" + str(_chat_actor_restart_count) + "), attempting auto-restart...")

    // 清理旧的 mailbox
    _chat_actor_mailbox = null

    // 重启
    let result = spawn_chat_actor()
    if result["status"] == "started" || result["status"] == "already_running" {
        debug("ChatSessionActor auto-restart successful")
        return true
    } else {
        debug("ChatSessionActor auto-restart failed: " + str(result.get("error", "unknown")))
        return false
    }
}

/** 通过 actor 处理用户输入（阻塞等待 actor 响应） */
fn tui_chat_handler_actor(user_input: str, file_paths: list = []): str {
    // v1.46.15: 确保 ChatSessionActor 存活，如果退出则自动重启
    if !_ensure_chat_actor_alive() {
        let _p = {"i18n_key": "error.actorRestartFailed", "params": dict()}
        return json_stringify(_p)
    }

    _chat_actor_req_counter = _chat_actor_req_counter + 1
    let request_id = "req-" + str(_chat_actor_req_counter)
    let request = {
        "type": "user_input",
        "content": user_input,
        "file_paths": file_paths,
        "request_id": request_id
    }

    try {
        _chat_actor_mailbox.send(request)
    } catch RuntimeError err {
        // v1.46.15: 发送失败说明 actor 已退出，尝试重启后重试
        debug("tui_chat_handler_actor: send failed, actor may have exited: " + err.message)
        _chat_actor_mailbox = null
        if !_ensure_chat_actor_alive() {
            let _p = {"i18n_key": "error.actorRestartFailed", "params": dict()}
            return json_stringify(_p)
        }
        // 重试发送
        try {
            _chat_actor_mailbox.send(request)
        } catch {
            let _p = {"i18n_key": "error.actorSendFailed", "params": dict()}
            return json_stringify(_p)
        }
    } catch {
        debug("tui_chat_handler_actor: send failed (unknown error)")
        _chat_actor_mailbox = null
        if !_ensure_chat_actor_alive() {
            let _p = {"i18n_key": "error.actorRestartFailed", "params": dict()}
            return json_stringify(_p)
        }
        try {
            _chat_actor_mailbox.send(request)
        } catch {
            let _p = {"i18n_key": "error.actorSendFailed", "params": dict()}
            return json_stringify(_p)
        }
    }

    // 等待响应，按 request_id 匹配，丢弃过时响应
    while true {
        let response = _chat_actor_mailbox.receive()
        if response == null {
            // v1.46.15: actor 退出，尝试重启
            debug("tui_chat_handler_actor: actor exited during wait, attempting restart")
            _chat_actor_mailbox = null
            if _ensure_chat_actor_alive() {
                // 重启成功，返回错误提示让用户重试
                let _p = {"i18n_key": "error.actorRestarted", "params": dict()}
                return json_stringify(_p)
            } else {
                let _p = {"i18n_key": "error.actorExited", "params": dict()}
                return json_stringify(_p)
            }
        }

        let resp_type = ""
        // v1.46.3: Check for error map first (contains '__error__' key)
        let is_error_map = false
        try { is_error_map = response["__error__"] == true } catch {}
        if is_error_map {
            let _params = {"message": response["message"]}
            let _payload = {"i18n_key": "error.actorException", "params": _params}
            return json_stringify(_payload)
        }
        try { resp_type = response["type"] } catch RuntimeError err {
            // 收到错误 map（如 {'__error__': ..., 'message': ...}）
            let _params = {"message": err.message}
            let _payload = {"i18n_key": "error.actorException", "params": _params}
            return json_stringify(_payload)
        } catch {
            let _p = {"i18n_key": "error.actorInvalidResponse", "params": dict()}
            return json_stringify(_p)
        }
        let resp_id = ""
        try { resp_id = response["request_id"] } catch {}

        // actor_status（如 exit 确认）无 request_id，直接处理
        if resp_type == "actor_status" {
            let _params = {"status": response["status"]}
            let _payload = {"i18n_key": "error.actorStatus", "params": _params}
            return json_stringify(_payload)
        }

        // 按 request_id 匹配；不匹配的是过时响应，丢弃
        if resp_id != request_id {
            debug("tui_chat_handler_actor: 丢弃过时响应 req_id=" + resp_id + " (期望 " + request_id + ")")
            continue
        }

        if resp_type == "response_complete" {
            return response["content"]
        }
        if resp_type == "error" {
            let _params = {"message": response["error_msg"]}
            let _payload = {"i18n_key": "error.generic", "params": _params}
            return json_stringify(_payload)
        }

        let _params = {"type": resp_type}
        let _payload = {"i18n_key": "error.unknownResponseType", "params": _params}
        return json_stringify(_payload)
    }
}

/** 退出长驻 actor */
fn exit_chat_actor() {
    if _chat_actor_mailbox != null {
        _chat_actor_mailbox.send({"type": "exit"})
        try {
            let status = _chat_actor_mailbox.receive()
            if status != null {
                let resp_type = ""
                try { resp_type = status["type"] } catch {}
                if resp_type == "actor_status" {
                    debug("ChatSessionActor exited: " + status["status"])
                }
            }
        } catch RuntimeError err {
            debug("exit_chat_actor: receive failed: " + err.message)
        } catch {
            debug("exit_chat_actor: receive failed (unknown)")
        }
        _chat_actor_mailbox = null
        _chat_actor_session_id = ""
    }
}

/** 发送心跳到 actor（非阻塞，维持 actor 存活） */
fn send_heartbeat() {
    if _chat_actor_mailbox != null {
        try {
            _chat_actor_mailbox.send({"type": "heartbeat"})
            _chat_actor_last_heartbeat = time()  // v1.46.15: 更新心跳时间
        } catch {
            // 心跳失败说明 actor 可能已死，忽略错误
        }
    }
}

/** 检查 actor 是否正在运行 */
fn is_chat_actor_running(): bool {
    return _chat_actor_mailbox != null
}

/** v1.46.15: 获取 ChatSessionActor 的健康状态和诊断信息
 *  返回: map 包含运行状态、重启次数、最后心跳时间等 */
fn get_chat_actor_health(): map {
    let is_alive = _is_chat_actor_alive()
    let time_since_heartbeat = 0.0
    if _chat_actor_last_heartbeat > 0 {
        time_since_heartbeat = time() - _chat_actor_last_heartbeat
    }

    let status_str = "stopped"
    if is_alive {
        status_str = "running"
    }

    return {
        "status": status_str,
        "session_id": _chat_actor_session_id,
        "restart_count": _chat_actor_restart_count,
        "last_heartbeat": _chat_actor_last_heartbeat,
        "time_since_heartbeat": time_since_heartbeat,
        "request_counter": _chat_actor_req_counter
    }
}

/** v1.46.15: 记录 ChatSessionActor 错误到日志文件
 *  错误日志保存在 .helen/actor_errors.log */
fn log_actor_error(error_type: str, message: str) {
    let log_path = get_cwd() + "/.helen/actor_errors.log"
    let timestamp_str = str(time())
    let log_entry = "[" + timestamp_str + "] [" + error_type + "] " + message + "\n"

    try {
        // 追加写入
        let existing = ""
        if path_exists(log_path) {
            existing = read_file(log_path)
        }
        write_file(log_path, existing + log_entry)
    } catch {
        // 日志写入失败不影响主流程
        debug("Failed to write actor error log: " + error_type + " - " + message)
    }
}

// 向后兼容：TUIChatAgent 函数别名
fn TUIChatAgent(user_input: str, file_paths: list = []): str {
    return tui_chat_handler_actor(user_input, file_paths)
}
