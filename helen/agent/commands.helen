// ═══════════════════════════════════════════════════════════════════
// Helen Programming Agent - 斜杠命令系统
// ═══════════════════════════════════════════════════════════════════
//
// 实现 Claude Code 风格的斜杠命令
//
// 支持的命令：
// - /help              显示帮助信息
// - /clear             清空对话上下文（保留会话实体，插入 BoundaryMarker）
// - /clear-session [<sid>]  删除整个会话（级联删除 spawn transcripts）
// - /compress          压缩上下文
// - /stats             显示会话统计
// - /memory            显示记忆系统状态
// - /working-memory    显示工作记忆内容
//
// 使用示例：
//   let cmd = parse_command("/help")
//   if cmd["is_command"] {
//       execute_command(cmd)
//   }
//

import std.context.*
import std.core.*
import std.dict.*
import std.file.*
import std.list.*
import std.path.*
import std.str.*
import std.transcript.*
import "output.helen"
import "context_manager.helen"
import "system_reminders.helen"

// ── 命令解析 ──────────────────────────────────────────────────────

/** 解析斜杠命令
 *  返回: {"is_command": bool, "command": str, "args": list<str>} */
fn parse_command(text: str): map {
    // 预处理：去除前后空白 + 全角斜杠归一化
    let trimmed = strip(text)
    trimmed = replace(trimmed, "／", "/")

    // 检查是否以 / 开头
    if !startswith(trimmed, "/") {
        return {"is_command": false, "command": "", "args": []}
    }

    // 移除 / 前缀
    let without_slash = trim_prefix(trimmed, "/")

    // 分割命令和参数
    let parts = split(without_slash, " ")
    if len(parts) == 0 {
        return {"is_command": false, "command": "", "args": []}
    }

    let command = parts[0]
    let args = []
    let i = 1
    while i < len(parts) {
        if parts[i] != "" {
            args = args + [parts[i]]
        }
        i = i + 1
    }

    return {
        "is_command": true,
        "command": command,
        "args": args
    }
}

// ── 命令执行 ──────────────────────────────────────────────────────

/** 执行斜杠命令
 *  返回: 命令响应文本（可能为空），空字符串 + 非 is_command 表示未识别
 *
 *  注：v5.2 之前每个命令都有 _cmd_X()（CLI 直接打印）+ _cmd_X_response()（返回字符串）
 *  两个版本。v5.2 合并为单一 _cmd_X() 返回字符串。 */
fn execute_command(cmd: map): str {
    if !cmd["is_command"] {
        return ""
    }

    let command = cmd["command"]
    let args = cmd["args"]

    match command {
        case "help" {
            return _cmd_help()
        }
        case "clear" {
            return _cmd_clear()
        }
        case "clear-session" {
            return _cmd_clear_session(args)
        }
        case "compress" {
            return _cmd_compress()
        }
        case "stats" {
            return _cmd_stats()
        }
        case "memory" {
            return _cmd_memory()
        }
        case "context" {
            return _cmd_context()
        }
        case "version" {
            return _cmd_version()
        }
        case "session" {
            return _cmd_session()
        }
        case "pin" {
            return _cmd_pin(args)
        }
        case "unpin" {
            return _cmd_unpin(args)
        }
        case "search" {
            return _cmd_search(args)
        }
        case "working-memory" {
            return _cmd_working_memory(args)
        }
        case "cleanup-sessions" {
            return _cmd_cleanup_sessions()
        }
        default {
            return build_unknown_command_text(command)
        }
    }
}

/** 检查是否为退出命令 */
// ── 命令实现 ──────────────────────────────────────────────────────
//
// 注：v5.2 之前每个命令有 _cmd_X()（CLI 直接打印）+ _cmd_X_response()（返回字符串）
// 两个版本。v5.2 合并为单一 _cmd_X() 返回字符串。

/** 构建帮助文本 */
fn build_help_text(): str {
    let text = "## 可用命令\n\n"
    text = text + "| 命令 | 说明 |\n"
    text = text + "|------|------|\n"
    text = text + "| `/help` | 显示本帮助信息 |\n"
    text = text + "| `/clear` | 清空对话历史并重置所有状态（保留会话实体，插入 BoundaryMarker） |\n"
    text = text + "| `/clear-session [<sid>]` | 删除整个会话（级联删除 spawn transcripts）；无参数则删当前会话 |\n"
    text = text + "| `/compress` | LLM 语义压缩上下文（保留语义，释放 token 空间） |\n"
    text = text + "| `/context` | 查看上下文详情（占用率、token、版本、会话目录、工作记忆） |\n"
    text = text + "| `/stats` | 查看会话统计（消息数、token、对话轮次） |\n"
    text = text + "| `/memory` | 查看记忆系统状态（Agent 记忆 + 用户偏好） |\n"
    text = text + "| `/version` | 查看 Helen 语言版本 |\n"
    text = text + "| `/session` | 查看当前会话信息（ID、目录、transcript 文件数） |\n"
    text = text + "| `/pin <uuid>` | 钉住指定消息，使其在所有压缩策略下均被保留 |\n"
    text = text + "| `/unpin <uuid>` | 取消钉住指定消息 |\n"
    text = text + "| `/search <query>` | 在当前上下文中全文搜索消息 |\n"
    text = text + "| `/working-memory` | 查看工作记忆内容（`get <key>` / `stats`） |\n"
    text = text + "| `/cleanup-sessions` | 清理空 session（只有 meta 无对话的 helen test 副产物） |\n"
    text = text + "\n> 提示：直接输入文本与 AI 对话，或使用上述斜杠命令执行操作\n"
    return text
}

/** 构建未知命令的提示文本 */
fn build_unknown_command_text(command: str): str {
    return "❌ 未知命令: /" + command + "\n\n输入 /help 查看可用命令"
}

/** /help - 显示帮助信息 */
fn _cmd_help(): str {
    return build_help_text()
}

/** /clear - 清空对话上下文并重置所有状态
 *  __HELEN_CLEAR_OK__ 是静默标记，Python 后端会解析并发送 clear_messages 事件到前端
 *  让 Web UI 同步清空显示的消息和 localStorage 中的会话 ID */
fn _cmd_clear(): str {
    clear_context()
    ContextManager.reset()
    reset_turn_counter()
    return "✅ 对话历史已清空，状态已重置。\n__HELEN_CLEAR_OK__"
}

/** /clear-session [<sid>] - 删除整个会话（级联删除 spawn transcripts）
 *  无参数时删除当前会话；带 <sid> 参数时删除指定会话。
 *  复用斜杠命令路径（不走特殊内部协议），与 /clear 语义区分：
 *    - /clear          = 清空对话历史（保留会话实体，transcript 仍在，插入 BoundaryMarker）
 *    - /clear-session  = 删除整个会话（级联删除 spawn transcripts，transcript 文件被移除）
 *
 *  __HELEN_CLEAR_SESSION_OK__ 是静默标记，Python 后端（chat.py DELETE 端点）
 *  解析后同步删除 Web UI SQLite 中该会话的消息和会话实体。
 *
 *  设计背景：见 reports/context-and-transcript-architecture.md §反馈 2（v2.1 定稿）。
 *  依赖 Helen v1.23.7+ 的 delete_session(cascade=true) / delete_current_session(cascade=true)。 */
fn _cmd_clear_session(args: list): str {
    let target = ""
    if len(args) > 0 {
        target = args[0]
    }

    let cur = ""
    try {
        cur = get_session_id()
    } catch {
        cur = ""
    }

    // 列出将要被级联删除的 spawn sessions（用于响应文本，供用户审计）
    let parent_for_display = target
    if parent_for_display == "" || parent_for_display == cur {
        parent_for_display = cur
    }
    let children_count = 0
    if parent_for_display != "" {
        try {
            let children = get_spawned_sessions(parent_for_display)
            if children != null && len(children) > 0 {
                children_count = len(children)
            }
        } catch {
            // get_spawned_sessions 不可用，静默忽略
        }
    }

    let header = "## 会话删除\n\n"
    try {
        if target == "" || target == cur {
            // 删除当前会话：级联删除其 spawn 树
            delete_current_session(confirm=true, cascade=true)
            // 清除 current_session_id 文件，强制下次调用创建新 session
            try {
                if path_exists(".helen/current_session_id") {
                    delete_file(".helen/current_session_id")  // 跨平台：用 stdlib
                }
            } catch {
                // 清除文件失败不影响主流程
            }
            let text = header
            text = text + "- 操作: ✅ 已删除当前会话\n"
            if cur != "" {
                text = text + "- 会话 ID: " + cur + "\n"
            }
            if children_count > 0 {
                text = text + "- 级联删除: " + str(children_count) + " 个 spawn session\n"
            }
            return text + "\n__HELEN_CLEAR_SESSION_OK__"
        } else {
            delete_session(target, cascade=true)
            let text = header
            text = text + "- 操作: ✅ 已删除指定会话\n"
            text = text + "- 会话 ID: " + target + "\n"
            if children_count > 0 {
                text = text + "- 级联删除: " + str(children_count) + " 个 spawn session\n"
            }
            return text + "\n__HELEN_CLEAR_SESSION_OK__"
        }
    } catch RuntimeError err {
        return header + "- 操作: ❌ 删除失败\n- 错误: " + err.message + "\n"
    } catch {
        return header + "- 操作: ❌ 删除失败\n- 原因: 需要 Helen v1.23.7+ 的 cascade 删除支持\n"
    }
}

/** /compress - 压缩上下文（LLM 语义摘要，保留上下文）
 *  使用 compress_context("summarize") 强制 LLM 生成语义摘要。
 *  曾被 hahalee000000/helen#13 阻塞（TranscriptStore 路径忽略 strategy），已在上游修复。
 *  WORKAROUND: hahalee000000/helen#23 — compressed_tokens 返回值错误，改用 context_stats() */
fn _cmd_compress(): str {
    let before_stats = context_stats()
    let original_tokens = before_stats["total_tokens"]

    let result = compress_context("summarize")

    // WORKAROUND for helen#23: compress_context 返回的 compressed_tokens 错误
    // 改用 context_stats() 获取压缩后的实际 tokens
    let after_stats = context_stats()
    let compressed_tokens = after_stats["total_tokens"]

    if original_tokens != null && compressed_tokens != null {
        return "✅ 上下文已压缩: " + str(original_tokens) + " → " + str(compressed_tokens) + " tokens"
    }
    return "✅ 上下文压缩完成。"
}

/** /stats - 显示会话统计 */
fn _cmd_stats(): str {
    let text = "## 会话统计\n\n"
    let stats = ContextManager.get_stats()
    if stats["status"] == "ok" {
        text = text + "- 消息数: " + str(stats["message_count"]) + "\n"
        text = text + "- 总 tokens: " + str(stats["total_tokens"]) + "\n"
        let usage_pct = int(stats["usage_ratio"] * 100)
        text = text + "- 上下文占用: " + str(usage_pct) + "%\n"
    } else {
        text = text + "上下文统计不可用（" + str(stats["error"]) + "）\n"
    }
    text = text + "- 对话轮次: " + str(get_turn_counter()) + "\n"
    text = text + "- Helen 版本: v" + ContextManager.get_version() + "\n"
    return text
}

/** /memory - 显示记忆系统状态 */
fn _cmd_memory(): str {
    let text = "## 记忆系统状态\n\n"
    if path_exists(".helen/MEMORY.md") {
        let mc = read_file(".helen/MEMORY.md")
        text = text + "- Agent 记忆: " + str(len(mc)) + " 字符\n"
    } else {
        text = text + "- Agent 记忆: （空）\n"
    }
    if path_exists(".helen/USER.md") {
        let up = read_file(".helen/USER.md")
        text = text + "- 用户偏好: " + str(len(up)) + " 字符\n"
    } else {
        text = text + "- 用户偏好: （空）\n"
    }
    text = text + "\n记忆文件: .helen/MEMORY.md, .helen/USER.md\n"
    return text
}

// ── v1.19-v1.20 新增命令 ────────────────────────────────────────

/** /context - 显示上下文状态 */
fn _cmd_context(): str {
    let text = "## 上下文状态\n\n"
    let stats = ContextManager.get_stats()
    if stats["status"] == "ok" {
        text = text + "- 消息数: " + str(stats["message_count"]) + "\n"
        text = text + "- 总 tokens: " + str(stats["total_tokens"]) + "\n"
        let usage_pct = int(stats["usage_ratio"] * 100)
        text = text + "- 上下文占用: " + str(usage_pct) + "%\n"
        text = text + "- 钉住消息: " + str(stats["pinned_count"]) + "\n"
        let wm = stats["working_memory"]
        if wm != null && len(wm) > 0 {
            // 统计非空字段（wm 是 data 字段：{task, active_files, decisions, todos, errors}）
            let non_empty = 0
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    non_empty = non_empty + 1
                }
            }
            text = text + "- 工作记忆条目: " + str(non_empty) + "/" + str(len(keys(wm))) + "\n"
        }
    } else {
        text = text + "上下文统计不可用（" + str(stats["error"]) + "）\n"
    }
    text = text + "- Helen 版本: v" + ContextManager.get_version() + "\n"
    let session_dir = ContextManager.get_session_dir()
    if session_dir != "" {
        text = text + "- 会话目录: " + session_dir + "\n"
    } else {
        text = text + "- 会话目录: ~/.helen/sessions/（全局）\n"
    }
    return text
}

/** /version - 显示 Helen 语言版本 */
fn _cmd_version(): str {
    return "Helen 语言版本: v" + ContextManager.get_version()
}

/** /session - 显示当前会话信息 */
fn _cmd_session(): str {
    let text = "## 会话信息\n\n"
    try {
        let sid = get_session_id()
        if sid != null && sid != "" {
            text = text + "- 会话 ID: " + sid + "\n"
        } else {
            text = text + "- 会话 ID: （未初始化）\n"
        }
    } catch {
        text = text + "- 会话 ID: （不可用）\n"
    }
    let session_dir = ContextManager.get_session_dir()
    if session_dir != "" {
        text = text + "- 会话目录: " + session_dir + "\n"
    } else {
        text = text + "- 会话目录: ~/.helen/sessions/（全局）\n"
    }
    if session_dir != "" && path_exists(session_dir) {
        try {
            let files = list_dir(session_dir)
            // 只统计有 transcript.jsonl 的目录（排除空目录）
            let transcript_count = 0
            for f in files {
                let transcript_path = path_join(session_dir, f, "transcript.jsonl")
                if path_exists(transcript_path) {
                    transcript_count = transcript_count + 1
                }
            }
            text = text + "- transcript 文件: " + str(transcript_count) + "\n"
        } catch {
            text = text + "- transcript 文件: （无法读取）\n"
        }
    }
    return text
}

/** /pin <uuid> - 钉住消息 */
fn _cmd_pin(args: list): str {
    if len(args) == 0 {
        let pinned = ContextManager.get_pinned()
        if len(pinned) == 0 {
            return "当前没有钉住的消息。\n用法: /pin <uuid> 钉住消息，使其免疫压缩"
        }
        let text = "已钉住的消息（" + str(len(pinned)) + " 条）:\n"
        for uuid in pinned {
            text = text + "  • " + str(uuid) + "\n"
        }
        return text
    }
    let uuid = args[0]
    if ContextManager.pin(uuid) {
        return "✅ 已钉住消息: " + uuid + "\n该消息将在上下文压缩时被保留"
    }
    return "❌ 钉住失败（消息不存在或 API 不可用）"
}

/** /unpin <uuid> - 取消钉住消息 */
fn _cmd_unpin(args: list): str {
    if len(args) == 0 {
        let pinned = ContextManager.get_pinned()
        if len(pinned) == 0 {
            return "当前没有钉住的消息。\n用法: /unpin <uuid> 取消钉住指定消息"
        }
        let text = "已钉住的消息（" + str(len(pinned)) + " 条）:\n"
        for uuid in pinned {
            text = text + "  • " + str(uuid) + "\n"
        }
        return text + "\n用法: /unpin <uuid> 取消钉住指定消息"
    }
    let uuid = args[0]
    if ContextManager.unpin(uuid) {
        return "✅ 已取消钉住: " + uuid
    }
    return "❌ 取消钉住失败（消息不在钉住列表中或 API 不可用）"
}

/** /search <query> - 搜索上下文
 *  v1.23：改用 search_transcript 直接搜磁盘上的 transcript 文件，
 *  不依赖内存 store（解决"首次请求即 /search"时 store 空的 corner case，
 *  以及 Per-Main Fresh Context 下斜杠命令分支看不到 LLM 历史的问题）。 */
fn _cmd_search(args: list): str {
    if len(args) == 0 {
        return "用法: /search <query>\n在当前会话的持久化 transcript 中搜索匹配的消息"
    }
    let query = join(args, " ")
    let text = ""
    try {
        let sid = get_session_id()
        let matches = search_transcript(query, sid, "current", "", false, 10)
        if matches == null || len(matches) == 0 {
            text = "## 搜索结果\n\n未找到匹配 '" + query + "' 的消息"
        } else {
            text = "## 搜索结果\n\n匹配 " + str(len(matches)) + " 条:\n\n"
            for msg in matches {
                let role = msg["role"]
                let uuid = msg["message_uuid"]
                let snippet = msg["snippet"]
                text = text + "**[" + str(role) + "]** " + str(snippet) + "\n"
                text = text + "- UUID: `" + str(uuid) + "`\n\n"
            }
            text = text + "提示：使用 `/pin <uuid>` 钉住重要消息，使其在上下文压缩时被保留"
        }
    } catch RuntimeError err {
        text = "## 搜索失败\n\n- 错误: " + err.message
    } catch {
        text = "## 搜索失败\n\n- 原因: search_transcript() 不可用，需要 Helen v1.22+"
    }
    return text
}

/** /working-memory — 查看工作记忆内容
 *  用法:
 *    /working-memory         显示所有工作记忆条目
 *    /working-memory get <key>  显示指定 key 的值
 *    /working-memory stats   显示统计信息 */
fn _cmd_working_memory(args: list): str {
    if len(args) == 0 {
        // 显示所有工作记忆
        let text = "## 工作记忆\n\n"
        try {
            let result = working_memory_get()
            // working_memory_get() 返回 {"status": "ok", "data": {...}}
            if result["status"] != "ok" {
                return text + "❌ 不可用: " + str(result["error"])
            }
            let wm = result["data"]
            // 检查是否为空（所有字段都为空）
            let has_content = false
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    has_content = true
                }
            }
            if !has_content {
                return text + "（空）"
            }
            text = text + "### 当前内容\n\n"
            let sorted_keys = sort(keys(wm))
            for key in sorted_keys {
                let value = wm[key]
                // 空字段不显示
                if value == "" || len(value) == 0 {
                    continue
                }
                text = text + "- **" + key + "**: " + str(value) + "\n"
            }
            return text
        } catch RuntimeError err {
            return text + "（不可用 - working_memory_get() 需要 Helen v1.19+: " + err.message + "）"
        } catch {
            return text + "（不可用 - working_memory_get() 需要 Helen v1.19+）"
        }
    }

    if args[0] == "get" && len(args) > 1 {
        let key = args[1]
        try {
            let result = working_memory_get(key)
            // working_memory_get(key) 返回 {"status": "ok", "data": <value>}
            if result["status"] != "ok" {
                return "❌ 获取失败: " + str(result["error"])
            }
            let value = result["data"]
            if value == null {
                return "未找到 key: " + key
            }
            return "**" + key + "**: " + str(value)
        } catch {
            return "❌ 获取失败（working_memory_get() 不可用）"
        }
    }

    if args[0] == "stats" {
        let text = "## 工作记忆统计\n\n"
        try {
            let result = working_memory_get()
            if result["status"] != "ok" {
                return text + "（不可用）"
            }
            let wm = result["data"]
            // 统计非空字段数
            let non_empty = 0
            let total_size = 0
            for key in keys(wm) {
                let v = wm[key]
                if v != "" && len(v) > 0 {
                    non_empty = non_empty + 1
                }
                total_size = total_size + len(key) + len(str(v))
            }
            text = text + "- 非空字段: " + str(non_empty) + "/" + str(len(keys(wm))) + "\n"
            text = text + "- 总大小: " + str(total_size) + " bytes\n"
            return text
        } catch {
            return text + "（不可用）"
        }
    }

    return "用法: /working-memory [get <key>|stats]"
}

/** /cleanup-sessions - 清理空 session（helen test 副产物）
 *  删除条件：transcript 只有 1 行（session_meta）+ scope=env_override + 无 parent */
fn _cmd_cleanup_sessions(): str {
    let info = get_session_dir()
    if info["status"] != "ok" {
        return "❌ 无法获取 session 目录: " + info.get("error", "unknown")
    }
    let session_dir = info["session_dir"]

    // 列出所有 session_* 子目录（session_dir 本身就是 .helen/sessions/）
    let dir_list = list_dir(session_dir)

    let deleted = 0
    let kept = 0
    let errors = 0

    for name in dir_list {
        if !startswith(name, "session_") {
            continue
        }
        let full_path = path_join(session_dir, name, "transcript.jsonl")
        if !path_exists(full_path) {
            continue
        }

        try {
            // 读第一行检查 session_meta
            let content = read_file(full_path)
            let lines = split(content, "\n")
            // 过滤空行
            let real_lines = []
            for line in lines {
                if strip(line) != "" {
                    real_lines = real_lines + [line]
                }
            }

            if len(real_lines) != 1 {
                kept = kept + 1
                continue
            }

            let meta = json_parse(real_lines[0])
            // Helen map 不支持 .get()，用直接访问 + try-catch
            let scope = ""
            let parent = ""
            try { scope = meta["session_scope"] } catch {}
            try { parent = meta["parent_session_id"] } catch {}

            // 只删除 env_override + 无 parent 的空 session
            if scope != "env_override" || parent != "" {
                kept = kept + 1
                continue
            }

            // 删除目录（跨平台：用 stdlib delete_dir）
            let target_path = path_join(session_dir, name)
            try {
                delete_dir(target_path, recursive=true)
            } catch {
                // 删除失败，计数为错误
                errors = errors + 1
                continue
            }
            deleted = deleted + 1
        } catch {
            errors = errors + 1
        }
    }

    return "✅ 清理完成\n\n- 删除: " + str(deleted) + " 个空 session\n- 保留: " + str(kept) + " 个 session\n- 错误: " + str(errors)
}
