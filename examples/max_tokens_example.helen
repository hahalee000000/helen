// 示例：使用 max-tokens 控制 LLM 响应长度
//
// 这个示例展示了如何在 agent 声明中使用 max-tokens 参数
// 来控制 LLM 响应的最大输出 token 数。

agent 简短回答者() {
    描述 "你是一个简洁的助手，只回答关键信息"
    大模型 "qwen3.7-plus"
    温度 0.7
    最大轮次 1
    最大tokens 100  // 限制响应最多 100 个 tokens

    主函 {
        返回 llm act "用一句话解释什么是人工智能"
    }
}

agent 详细回答者() {
    描述 "你是一个详细的助手，提供全面的解释"
    大模型 "qwen3.7-plus"
    温度 0.7
    最大轮次 1
    最大tokens 2000  // 允许更长的响应

    主函 {
        返回 llm act "详细解释人工智能的历史和发展"
    }
}

主函 {
    打印("=== 简短回答 ===")
    简短 = 简短回答者()
    打印(简短)

    打印("\n=== 详细回答 ===")
    详细 = 详细回答者()
    打印(详细)
}
