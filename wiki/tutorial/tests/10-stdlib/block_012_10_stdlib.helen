main {
    main {
        // Parse
        let data = json_parse('{"name": "Alice", "age": 30}')
        print(data.name)              // "Alice"

        // Generate
        let json_str = json_stringify({"name": "Alice"})
        // '{"name": "Alice"}'

        // File operations
        json_save("data.json", data)
        let loaded = json_load("data.json")
    }
}