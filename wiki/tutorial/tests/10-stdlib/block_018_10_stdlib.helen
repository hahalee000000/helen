// Test: 10-stdlib.md:405

main {
    main {
        // Direct access
        print(argv)  // ["--verbose", "--output=json", "--port=8080", "input.txt"]
        print(len(argv))  // 4

        // Check for specific arguments
        if contains(argv, "--verbose") {
            print("Verbose mode enabled")
        }

        // Iterate over all arguments
        for arg in argv {
            print("Argument: " + arg)
        }
    }
}