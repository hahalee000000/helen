// Test: 10-stdlib.md:260

main {
    main {
        // Base64
        base64_encode("Hello")        // "SGVsbG8="
        base64_decode("SGVsbG8=")     // "Hello"

        // HTML escaping
        html_escape("<script>")       // "&lt;script&gt;"
        html_unescape("&lt;")         // "<"
    }
}