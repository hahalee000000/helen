// Test: 03-functions.md:75
// @should_fail

fn add(a: int, b: int): int {
    return a + b
}

main {
    main {
        let x = 1.5
        add(x, 2)        // ❌ Runtime error: argument 1 type 'FloatType' is not compatible with parameter type 'IntType'

        let y = 10
        add(y, 2)        // ✅ Correct
    }
}