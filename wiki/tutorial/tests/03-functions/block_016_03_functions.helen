// Test: 03-functions.md:288

// === Context from preceding blocks ===
fn greet(name) {
    print("Hello, " + name + "!")
}

fn add(a, b) {
    return a + b
}

fn factorial(n: int): int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

shared let global_x = 100

fn test() {
    print(global_x)    // ✅ Can access shared variable
    print(local_x)     // ✅ Can access local variable
}

// Closure captures outer variable
fn make_adder(x) {
    return fn(y) { return x + y }
}

fn make_multiplier(factor) {
    return fn(x) { return x * factor }
}

alias <canonical> as <alias_name>

// === Test code ===
alias len as 我的长度
alias print as 输出

main {
    主函 {
        我的长度([1, 2, 3])   // 3
        输出("hello")
    }
}