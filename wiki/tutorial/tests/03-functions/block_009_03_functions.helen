// Test: 03-functions.md:130

// === Context from preceding blocks ===
fn greet(name) {
    print("Hello, " + name + "!")
}

fn add(a, b) {
    return a + b
}

fn factorial(n: int): int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

// === Test code ===
fn double(x) {
    return x * 2
}

fn apply(op, value) {
    // In v1, functions are referenced by name
    // Note: cannot use 'fn' as a parameter name (it is a keyword)
    print(double(value))
}