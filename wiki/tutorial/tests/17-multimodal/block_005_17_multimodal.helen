main {
    main {
        on_media fn(parts, provider) {
            // Only hand-write for non-standard providers
            return parts.map(fn(part) {
                return {
                    "type": "media",
                    "mime_type": part.mime,
                    "data": 媒体转base64(part),
                    "encoding": "base64"
                }
            })
        }
    }
}