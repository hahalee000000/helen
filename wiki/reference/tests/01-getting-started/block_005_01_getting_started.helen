// Test: 01-getting-started.md:500

// Pure Chinese Hello World
函数 打招呼(名字: str) {
    print("你好, " + 名字)
}

main {
    主函 {
        print("你好，世界！")
    }

    // Chinese variables and functions

    main {
        let 姓名 = "张三"
        打招呼(姓名)
    }

    // Mixed Chinese and English
    main {
        let 年龄 = 30
        如果 年龄 >= 18 {
            print("成年")
        } 否则 {
            print("未成年")
        }
    }
}