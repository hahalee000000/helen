// Test: 04-control-flow.md:166

main {
    main {
        for i in range(5) {
            print(i)    // 0, 1, 2, 3, 4
        }

        for i in range(1, 6) {
            print(i)    // 1, 2, 3, 4, 5
        }

        for i in range(0, 10, 2) {
            print(i)    // 0, 2, 4, 6, 8
        }
    }
}