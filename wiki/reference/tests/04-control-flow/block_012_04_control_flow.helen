// Test: 04-control-flow.md:198

main {
    main {
        for i in range(10) {
            if i == 3 {
                continue    // Skip 3
            }
            if i == 7 {
                break       // Exit at 7
            }
            print(i)
        }
        // 0, 1, 2, 4, 5, 6
    }
}