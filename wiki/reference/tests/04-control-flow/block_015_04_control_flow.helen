// Test: 04-control-flow.md:248

main {
    main {
        let score = 85

        match score {
            case 90..100 { print("A") }
            case 80..89 { print("B") }
            case 70..79 { print("C") }
            case 60..69 { print("D") }
            default { print("F") }
        }
        // Output: B
    }
}