agent Claude分析 {
    main {
        let img = media("chart.png")
        
        // Use the built-in Claude adapter — one line
        let result = llm act "Analyze this chart"
            media(img)
            on_media fn(parts, provider) { return 转Claude格式(parts) }
        
        print(result)
    }
}