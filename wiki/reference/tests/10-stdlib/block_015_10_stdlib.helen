main {
    main {
        // Parse
        let rows = csv_parse("name,age\nAlice,30")
        // [["name", "age"], ["Alice", "30"]]

        // Generate
        csv_stringify([["a", "b"], ["1", "2"]])
        // "a,b\n1,2\n"

        // File operations
        csv_save("data.csv", rows)
        let loaded = csv_load("data.csv")
    }
}