main {
    main {
        // List all transcript sessions
        let sessions = list_sessions()
        for session in sessions {
            print(session["session_id"] + ": " + str(session["message_count"]) + " messages")
        }
        // Returns: [{"session_id": "...", "message_count": 50, "size_bytes": 2500, ...}]
    }
}