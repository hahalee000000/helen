// Test: 10-stdlib.md:377

main {
    main {
        // Parse
        let data = toml_parse("name = \"Alice\"\nage = 30")
        // {"name": "Alice", "age": 30}

        // Generate
        toml_stringify({"name": "Alice"})
        // "name = \"Alice\"\n"

        // File operations
        toml_save("config.toml", data)
        let loaded = toml_load("config.toml")
    }
}