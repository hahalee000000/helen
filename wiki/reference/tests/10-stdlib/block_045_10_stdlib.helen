// Test: 10-stdlib.md:1196

agent 异常检查助手 {
    description "Check for unhandled exceptions in code"
    main {
        let todos = grep_files("src/", "TODO.*exception", regex=true)
        if len(todos) > 0 {
            print("Found " + str(len(todos)) + " pending exception(s):")
            for match in todos {
                print("  " + match["file"] + ":" + str(match["line"]))
                print("    " + match["text"])
            }
        }
    }
}