main {
    main {
        // Parse
        let data = yaml_parse("name: Alice\nage: 30")
        // {"name": "Alice", "age": 30}

        // Generate
        yaml_stringify({"name": "Alice"})
        // "name: Alice\n"

        // File operations
        yaml_save("config.yaml", data)
        let loaded = yaml_load("config.yaml")
    }
}