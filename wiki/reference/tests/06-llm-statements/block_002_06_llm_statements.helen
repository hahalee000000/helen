// Test: 06-llm-statements.md:37

agent Translator(text: str, target: str) {
    description "Translate text"
    model "qwen-plus"
    temperature 0.3
    prompt """
    Translate to {{target}}:
    {{text}}
    """

    main {
        // bare form: automatically uses the rendered prompt
        let result = llm act
        return result
    }
}

main {
    main {
        let translated = Translator(text="Hello", target="French")
        print(translated)
    }
}