// Test: 02-variables-and-types.md:208

main {
    main {
        let a = [1, 2]
        let b = [3, 4]
        let c = a + b             // [1, 2, 3, 4]

        // Commonly used for incremental building
        let items = []
        items = items + ["a"]     // ["a"]
        items = items + ["b", "c"]  // ["a", "b", "c"]
    }
}