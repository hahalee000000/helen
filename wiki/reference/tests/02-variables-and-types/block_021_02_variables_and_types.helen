// Test: 02-variables-and-types.md:301

main {
    main {
        // Update a record in an array
        let users = [
          {"name": "Alice", "score": 85},
          {"name": "Bob", "score": 90}
        ]

        // Update the first user's score
        users[0]["score"] = 95

        // Add a new field
        users[1]["grade"] = "A"

        print(users)
        // [
        //   {"name": "Alice", "score": 95},
        //   {"name": "Bob", "score": 90, "grade": "A"}
        // ]
    }
}